{
  "name": "@rejtek/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Rejtek for Firefox: search and copy passwords from your home server",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:ext": "web-ext lint --source-dir dist",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest"
  },
  "dependencies": {
    "@rejtek/core": "*",
    "@rejtek/theme": "*",
    "@rejtek/ui": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  }
}
