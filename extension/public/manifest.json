{
  "manifest_version": 3,
  "name": "Rejtek",
  "version": "0.1.0",
  "description": "Search and copy your passwords from your Rejtek home server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rejtek@rejtek.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/rejtek.svg", "96": "icons/rejtek.svg" },
  "action": {
    "default_title": "Rejtek",
    "default_popup": "popup.html",
    "default_icon": "icons/rejtek.svg"
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "alarms", "activeTab", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
